# 1. 필요한 라이브러리 임포트
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures
from google.colab import files

# 2. 파일 업로드 및 로드 (안내 문구 제거)
uploaded = files.upload()
filename = list(uploaded.keys())[0]

if filename.endswith('.csv'):
    df = pd.read_csv(filename)
elif filename.endswith(('.xls', '.xlsx')):
    df = pd.read_excel(filename)
else:
    raise ValueError("CSV 또는 Excel 파일만 지원합니다.")

# 3. 숫자 열 자동 감지 및 데이터 정제
numeric_df = df.select_dtypes(include=[np.number])
x_col = numeric_df.columns[0]
y_col = numeric_df.columns[1]

df_clean = numeric_df[[x_col, y_col]].dropna()
X = df_clean[[x_col]].values
y = df_clean[y_col].values

# 4. 선형 및 비선형 회귀 모델 학습
lin_model = LinearRegression()
lin_model.fit(X, y)
y_lin_pred = lin_model.predict(X)

poly = PolynomialFeatures(degree=2)
X_poly = poly.fit_transform(X)
poly_model = LinearRegression()
poly_model.fit(X_poly, y)
y_nonlin_pred = poly_model.predict(X_poly)

# 5. 시각화 및 이미지 저장
plt.figure(figsize=(10, 6))
plt.scatter(X, y, color='black', alpha=0.7, label='Original Data')
plt.plot(X, y_lin_pred, color='blue', linewidth=2, label='Linear Regression')

sort_idx = X.ravel().argsort()
plt.plot(X[sort_idx], y_nonlin_pred[sort_idx], color='red', linestyle='--', linewidth=2, label='Non-linear Regression (Poly)')

plt.title(f'Regression Analysis ({x_col} vs {y_col})', fontsize=14)
plt.xlabel(x_col, fontsize=12)
plt.ylabel(y_col, fontsize=12)
plt.legend(fontsize=11)
plt.grid(True, linestyle=':', alpha=0.6)

plt.savefig('regression_result.png', dpi=300, bbox_inches='tight')
plt.show()
